# ── Провайдеры модели: облако и локаль под одним контрактом ─────────────
# Порядок пула: кто первый — основной (провайдеры: cloud,local; гибрид:
# local-first: local,cloud). Провайдер без LLM_<ИМЯ>_* пропускается.
LLM_PROVIDER_ORDER=cloud,local

# Температура генерации агентов (шаг адаптации): попадает в манифест прогона
LLM_TEMPERATURE=0.1

# Облачный провайдер (любой OpenAI-совместимый API) — baseline и fallback
LLM_CLOUD_BASE_URL=
LLM_CLOUD_MODEL=
LLM_CLOUD_API_KEY=
# Цены для экономики (экономика), рублей за 1M токенов
LLM_CLOUD_PRICE_IN_RUB_PER_1M=60
LLM_CLOUD_PRICE_OUT_RUB_PER_1M=180

# Локальный провайдер: llama.cpp / LM Studio / Ollama / vLLM (OpenAI-совместимые).
# Модель берите из полосы 4–8B под вашу память; имя — ровно как его
# отдаёт GET /v1/models вашего сервера. Дефолт ниже — LM Studio, другие
# варианты:
#   llama.cpp: llama-server -m <модель>.gguf --jinja --port 8081
#              → http://127.0.0.1:8081/v1
#   Ollama:    ollama pull qwen3:4b → http://127.0.0.1:11434/v1
#   vLLM:      minikube + port-forward 8001:80 → http://127.0.0.1:8001/v1
#              (подъём — k8s/README.md)
LLM_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LLM_LOCAL_MODEL=qwen3-4b
LLM_LOCAL_API_KEY=none
# Стек для guided decoding (guided): llama.cpp | lmstudio | ollama | vllm
# (пусто — авто-детект по порту: 11434 → ollama, 1234 → lmstudio,
# 8000 → vllm, прочее → llama.cpp)
LLM_LOCAL_STACK=lmstudio
# Путь к GGUF-файлу — для sha256 при выпуске версии (выпуск)
LLM_LOCAL_MODEL_PATH=
# Оценка владения: электричество+амортизация, рублей за 1M токенов (экономика)
LLM_LOCAL_RUB_PER_1M=2

# Postgres контура (docker-compose)
PG_DSN=postgresql://bank:bank@127.0.0.1:5434/bank

# Порты сервисов (менять не обязательно)
STAND_PORT=8100
BACKEND_PORT=8000
ACTIONS_PORT=8220
PDP_PORT=9100
GUARDRAIL_PORT=8300

# Жизнь токена сессии и карточки подтверждения, секунды
TOKEN_TTL_SEC=3600
CARD_TTL_SEC=120

# Кулдаун провайдера после 429/5xx, секунд
LLM_FAILOVER_COOLDOWN_SEC=60

# ── Эмбеддинги базы знаний (только для make snapshot) ────────────────────
# kb/vectors.json уже собран — эти переменные нужны, только если вы
# меняете статьи базы знаний и пересчитываете снапшот. Сервер
# эмбеддингов — любой OpenAI-совместимый /v1/embeddings; ниже — значения
# по умолчанию из kb/build_snapshot.py (префиксы — контракт модели).
#EMBED_MODEL=text-embedding-embeddinggemma-300m-qat
#EMBED_URL=http://127.0.0.1:1234/v1/embeddings
#EMBED_QUERY_PREFIX="task: search result | query: "
#EMBED_DOC_PREFIX="title: none | text: "

# ── Routing и анонимизация (малые модели и гибрид) ────────────────────────────────────
# ROUTING_MODE: off — пул по порядку; rule — таблица правил; prompt — малая модель
ROUTING_MODE=off
# Маскирование PII на транспорте облачного провайдера (1 — включено)
ANONYMIZE_CLOUD=1
#ANONYMIZE_LOG=1

# ── Датасет дообучения (шаг дистилляции) ──────────────────────────────────
# Захват вызовов бэкенда в JSON для сборки датасета (пусто — выключен).
# Бэкенд на время сбора поднимают так:
#   LLM_CAPTURE_DIR=data/finetune/capture make api
#LLM_CAPTURE_DIR=
# Учитель синтетики: cloud (LLM_CLOUD_*) или local (LLM_LOCAL_*)
#DATASET_TEACHER=cloud
